{
  "name": "mailtrain-client",
  "version": "2.0.0",
  "description": "Self hosted email newsletter app - client components",
  "main": "index.js",
  "scripts": {
    "js": "node --stack_size=8192 ./node_modules/webpack/bin/webpack.js",
    "watch-js": "webpack --watch",
    "css": "npm-run-all --sequential css-compile css-minify",
    "css-compile": "sass --load-path=. --style=expanded --source-map --embed-sources src/scss/mailtrain.scss dist/mailtrain.css",
    "css-minify": "cleancss -O1 --source-map --source-map-inline-sources --output dist/mailtrain.min.css dist/mailtrain.css",
    "watch-css": "nodemon --watch src/scss -e scss -x \"npm run css\"",
    "watch": "npm-run-all --parallel watch-css watch-js",
    "build": "npm-run-all --parallel css js"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/Mailtrain-org/mailtrain.git"
  },
  "license": "GPL-3.0",
  "homepage": "https://mailtrain.org/",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "dependencies": {
    "@coreui/coreui": "^2.1.16",
    "@fortawesome/fontawesome-free": "^5.15.3",
    "axios": "1.20.0",
    "bootstrap": "^4.6.0",
    "cheerio": "1.2.0",
    "clone": "^2.1.2",
    "datatables.net": "1.13.11",
    "datatables.net-bs4": "1.13.11",
    "ellipsize": "^0.1.0",
    "grapesjs": "0.23.6",
    "grapesjs-mjml": "1.0.8",
    "grapesjs-preset-newsletter": "1.0.2",
    "htmlparser2": "12.0.0",
    "i18next": "^19.9.2",
    "i18next-browser-languagedetector": "^4.3.1",
    "immutable": "5.1.9",
    "juice": "12.1.2",
    "lodash": "4.18.1",
    "mjml-browser": "4.18.0",
    "mjml-core": "4.18.0",
    "mjml-preset-core": "4.18.0",
    "moment": "2.30.1",
    "moment-timezone": "0.5.48",
    "nanoid": "3.3.18",
    "path-browserify": "1.0.1",
    "popper.js": "^1.16.1",
    "postcss-nesting": "14.0.1",
    "process": "0.11.10",
    "prop-types": "^15.7.2",
    "querystringify": "^2.2.0",
    "react": "^16.14.0",
    "react-ace": "^15.0.0",
    "react-ckeditor-component": "^1.1.0",
    "react-color": "^2.19.3",
    "react-day-picker": "^7.4.10",
    "react-dnd": "^9.5.1",
    "react-dnd-html5-backend": "^9.5.1",
    "react-dnd-touch-backend": "^9.5.1",
    "react-dom": "^16.14.0",
    "react-dropzone": "^10.2.2",
    "react-google-charts": "^3.0.15",
    "react-i18next": "^11.8.15",
    "react-router-dom": "5.3.4",
    "react-sortable-tree": "^2.8.0",
    "shallowequal": "^1.1.0",
    "slugify": "^1.5.2",
    "url": "0.11.4",
    "url-parse": "1.5.10"
  },
  "overrides": {
    "@babel/runtime": "7.28.4",
    "html-minifier": "npm:html-minifier-terser@6.1.0",
    "lodash-es": "4.18.1"
  },
  "devDependencies": {
    "@babel/cli": "^7.13.16",
    "@babel/core": "^7.14.0",
    "@babel/plugin-proposal-class-properties": "^7.13.0",
    "@babel/plugin-proposal-decorators": "^7.13.15",
    "@babel/plugin-proposal-function-bind": "^7.12.13",
    "@babel/preset-env": "^7.14.1",
    "@babel/preset-react": "^7.13.13",
    "babel-loader": "10.1.1",
    "clean-css-cli": "5.6.3",
    "copy-webpack-plugin": "14.0.0",
    "css-loader": "7.1.5",
    "nodemon": "3.1.14",
    "npm-run-all2": "9.0.3",
    "sass": "1.103.1",
    "sass-loader": "17.0.0",
    "style-loader": "4.0.0",
    "webpack": "5.110.1",
    "webpack-cli": "6.0.1"
  }
}
