{
  "name": "mailtrain",
  "private": true,
  "version": "2.0.0",
  "description": "Self hosted email newsletter app - server",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "sqlinit": "node setup/sql/init.js",
    "sqldump": "node setup/sql/dump.js | sed -e '/^\\/\\*.*\\*\\/;$/d' -e 's/.[0-9]\\{4\\}-[0-9][0-9]-[0-9][0-9] [0-9][0-9]:[0-9][0-9]:[0-9][0-9]./NOW()/g' > setup/sql/mailtrain${DUMP_NAME_SUFFIX}.sql",
    "sqldrop": "node setup/sql/drop.js",
    "sqlgen": "npm run sqldrop && DB_FROM_START=Y npm run sqlinit && npm run sqldump",
    "sqldumptest": "NODE_ENV=test DUMP_NAME_SUFFIX=-test npm run sqldump",
    "sqlresettest": "NODE_ENV=test npm run sqldrop && NODE_ENV=test npm run sqlinit",
    "starttest": "NODE_ENV=test node index.js",
    "_e2e": "NODE_ENV=test node test/e2e/index.js",
    "e2e": "npm run test:playwright",
    "lint:harness": "eslint lib/admin-bootstrap.js lib/auth-security.js lib/aws-ses-transport.js lib/browser-security.js lib/cas-auth.js lib/external-auth-adapter.js lib/file-cache-integrity.js lib/file-cache-reconciliation.js lib/file-cache-write-logging.js lib/geoip.js lib/html-sanitizer.js lib/log-redaction.js lib/mailgun-upload.js lib/openpgp-encrypt.js lib/outbound-fetch.js lib/rate-limit.js lib/report-execution-policy.js lib/request-rate-limiters.js lib/restricted-token-store.js lib/runtime-schema.js lib/safe-path.js lib/secret-envelope.js lib/secret-migration.js lib/secret-storage.js lib/session-security.js lib/test-database-safety.js lib/token-hash.js lib/upload-limits.js lib/user-agent.js lib/webhook-delivery-ledger.js lib/webhook-security.js routes/campaigns.js setup/security/*.js setup/validate-admin-password.js setup/validate-session-secret.js test/harness/*.js test/security/*.js test/integration/*.js test/playwright/*.js",
    "test": "npm run test:fast",
    "test:fast": "node --test test/harness/*.test.js test/security/*.test.js",
    "test:coverage": "c8 --reporter=text --reporter=lcov npm run test:fast",
    "test:integration": "NODE_ENV=test node test/integration/schema-smoke.js && NODE_ENV=test node test/integration/rbac-boundaries.js",
    "test:playwright": "playwright test --config test/playwright/playwright.config.js",
    "security:audit-role-grants": "node setup/security/audit-role-grants.js",
    "security:secrets": "node setup/security/secret-migration.js"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/Mailtrain-org/mailtrain.git"
  },
  "license": "GPL-3.0",
  "homepage": "https://mailtrain.org/",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "packageManager": "npm@11.19.0",
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "babel-eslint": "^10.0.3",
    "c8": "12.0.0",
    "chai": "4.5.0",
    "eslint-config-nodemailer": "^1.2.0",
    "grunt": "^1.0.3",
    "grunt-cli": "^1.3.2",
    "grunt-eslint": "^21.1.0",
    "lodash": "^4.18.1",
    "mocha": "11.8.0",
    "url-pattern": "^1.0.3"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "3.1121.0",
    "@coursetable/passport-cas": "0.1.4",
    "@xmldom/xmldom": "0.9.12",
    "bcryptjs": "3.0.3",
    "bluebird": "^3.7.2",
    "body-parser": "1.20.6",
    "bounce-handler": "7.3.2-fork.3",
    "capitalize": "^2.0.1",
    "compression": "1.8.1",
    "config": "5.0.1",
    "connect-flash": "^0.1.1",
    "connect-redis": "^3.4.2",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "csurf": "1.11.0",
    "csv-parse": "^4.8.3",
    "csv-stringify": "^5.3.6",
    "escape-html": "^1.0.3",
    "escape-string-regexp": "^1.0.5",
    "express": "4.22.2",
    "express-locale": "^1.0.5",
    "express-session": "1.19.0",
    "faker": "^4.1.0",
    "feedparser": "2.2.9",
    "fs-extra": "^7.0.1",
    "fs-extra-promise": "^1.0.1",
    "geoip-lite": "2.0.3",
    "gm": "1.25.1",
    "handlebars": "4.7.9",
    "hbs": "4.3.0",
    "he": "^1.2.0",
    "html-to-text": "10.0.1",
    "humanize": "0.0.9",
    "i18next": "^19.0.3",
    "isemail": "^3.2.0",
    "js-yaml": "3.15.2",
    "jsdom": "30.0.1",
    "juice": "12.1.2",
    "klaw-sync": "^6.0.0",
    "knex": "3.3.0",
    "libmime": "^4.2.1",
    "mailparser": "3.9.17",
    "memory-cache": "^0.2.0",
    "mjml": "5.4.0",
    "moment": "2.30.1",
    "moment-timezone": "0.5.48",
    "morgan": "1.12.0",
    "multer": "2.3.0",
    "mysql2": "3.24.2",
    "nanoid": "3.3.18",
    "node-ipc": "^9.1.1",
    "node-mocks-http": "^1.18.1",
    "node-object-hash": "^1.4.1",
    "nodeify": "^1.0.1",
    "nodemailer": "9.0.6",
    "npmlog": "^4.1.2",
    "openpgp": "6.3.1",
    "passport": "0.7.0",
    "passport-ldapauth": "3.0.1",
    "passport-ldapjs": "2.0.0",
    "passport-local": "^1.0.0",
    "serve-favicon": "^2.5.0",
    "slugify": "^1.3.6",
    "smtp-server": "3.19.4",
    "tmp-promise": "3.0.3",
    "toml": "^4.2.0",
    "try-require": "^1.2.1",
    "ua-parser-js": "2.0.10"
  },
  "overrides": {
    "ansi-regex@3.0.0": "3.0.1",
    "brace-expansion@<=1.1.17": "1.1.18",
    "ini@<1.3.6": "1.3.8",
    "minimatch@<=3.1.3": "3.1.4",
    "connect-redis": {
      "redis": "3.1.2"
    },
    "tmp@<0.2.7": "0.2.7"
  }
}
